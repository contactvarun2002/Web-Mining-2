class BehavioralTemporalEncoder(
    nn.Module
):

    def __init__(
        self,
        input_size=1,
        hidden_size=16
    ):

        super().__init__()

        self.gru = nn.GRU(
            input_size=input_size,
            hidden_size=hidden_size,
            batch_first=True
        )


    def forward(self, x):

        output, hidden = self.gru(x)

        return hidden[-1]


