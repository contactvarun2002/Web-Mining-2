def generate_quantum_representation(
    X_angles
):

    representations = []

    for sample in X_angles:

        output = qnode(
            torch.tensor(
                sample,
                dtype=torch.float32
            ),
            vqc_weights.detach()
        )

        output = torch.stack(
            output
        ).detach().numpy()

        representations.append(
            output
        )

    return np.asarray(
        representations
    )


